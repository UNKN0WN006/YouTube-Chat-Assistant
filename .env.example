# Needed only for generated answers. Without it the app still retrieves
# and shows the best transcript evidence, so the UI can be demoed safely.
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional. If present, metadata comes from the official YouTube Data API.
# If absent, the app uses YouTube oEmbed for title/channel information.
YOUTUBE_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
